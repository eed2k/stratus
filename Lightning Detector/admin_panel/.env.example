# Application
APP_SECRET_KEY=change-me-to-a-long-random-string

# DATABASE_URL
# Local dev (SQLite):
#   sqlite:///./data/panel.db
# Production (Neon Postgres) - copy the "Pooled connection" string from Neon
# console; the panel auto-rewrites postgres:// -> postgresql+psycopg:// and
# appends sslmode=require if missing.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb

ALERT_WEBHOOK_TOKEN=change-me-shared-with-pi

# Keep true in production (HTTPS). Set false only for local HTTP testing.
SECURE_COOKIES=true

# Clickatell One API (SMS only; no WhatsApp)
# Get the API key from https://portal.clickatell.com (One API setup, SMS).
CLICKATELL_API_KEY=
# Optional: shared secret expected on inbound DLR callbacks. Configure the
# same value in the Clickatell One API setup under Delivery Notifications.
CLICKATELL_DLR_TOKEN=

# Site name in SMS alert text, e.g. GLENCORE WONDERKOP
SITE_NAME=GLENCORE WONDERKOP

# Initial admin login (full access). Seeded on first boot if missing.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe!123

# Initial operator login (site user). Seeded on first boot if missing.
INITIAL_OPERATOR_EMAIL=operator@example.com
INITIAL_OPERATOR_PASSWORD=ChangeMe!Op-123
