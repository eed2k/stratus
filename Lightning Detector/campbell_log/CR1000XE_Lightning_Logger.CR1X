'===============================================================================
' AS3935 LIGHTNING DETECTION UNIT
'===============================================================================
'CR1000XE program for lightning detector integration
'Pi wiring:
'  GPIO 26 (bit-bang UART TX) -> C2
'  GND                       -> G
'  GPIO 19 (IRQ pulse mirror)-> P1
'
'Serial format sent by Pi:
'  L,<distance_km>,<energy>\r\n
'
'Example:
'  L,15,84230\r\n

Public LastLightningDistanceKm As Float
Public LastLightningEnergy As Long
Public LastSerialRecord As String * 40
Public SerialBytesReturned As Float
Public PulseCountScan As Float
Public PulseCountTotal As Float
Public ParsedNumeric(3) As Float
Public LightningRecordCount As Long
Public ParseErrorCount As Long

Dim SerialParsedOK As Boolean
Dim PulseSeenThisScan As Boolean

'One table, and it holds lightning only: distance, energy and the mirrored IRQ
'pulse count.
'
'The periodic LightningHealth table that used to sit here was removed. It wrote a
'row every minute carrying scan pulse counts, record counts and parse errors,
'which is detector housekeeping rather than weather: 1440 rows a day on a logger
'whose actual subject may produce none. The Pi already reports its own health to
'the lightning console over its hourly heartbeat, so the logger was keeping a
'second copy of something it is not the system of record for.
'
'ParseErrorCount and LightningRecordCount remain Public, so they are still
'visible in the logger live numeric display for troubleshooting. They are just
'not written to storage.
DataTable (LightningEvents, True, -1)
  Sample (1, LastLightningDistanceKm, FP2)
  Sample (1, LastLightningEnergy, Long)
  Sample (1, PulseCountTotal, FP2)
  Sample (1, LastSerialRecord, String)
EndTable

BeginProg
  'Set C1/C2 pair to 3.3 V logic for direct connection to Pi GPIO
  PortPairConfig(C1, 2)

  'Open ComC1 (C1 = TX, C2 = RX). Pi only transmits to logger, so C2 is used.
  'Format 16 = logic 1 high, 8N1 ASCII, suitable for LVTTL serial.
  SerialOpen(ComC1, 9600, 16, 0, 128)
  SerialFlush(ComC1)

  Scan(200, mSec, 0, 0)
    'SerialParsedOK describes THIS scan, so clear it at the top of every scan.
    'It is otherwise only cleared inside the "a record arrived" branch, which
    'leaves it holding the previous scan's answer whenever the UART is quiet, and
    'a stale True would suppress the pulse-only row below.
    SerialParsedOK = False

    'Count mirrored IRQ pulses from Pi on P1.
    'PConfig 3 = high frequency input with pull up, POption 0 = counts.
    PulseCount(PulseCountScan, 1, P1, 3, 0, 1, 0)
    PulseCountTotal = PulseCountTotal + PulseCountScan
    'A pulse on its own is worth a row: the IRQ mirror is the hardware witness
    'that the sensor fired, and it can arrive when the serial record does not.
    If PulseCountScan > 0 Then PulseSeenThisScan = True
    'A pulse on its own is worth a row: the IRQ mirror is the hardware witness
    'that the sensor fired, and it can arrive when the serial record does not.
    If PulseCountScan > 0 Then PulseSeenThisScan = True

    'Read oldest complete record from serial buffer.
    'BeginWord = "L", EndWord = CRLF, NBytes < 0 = read between begin/end.
    'Returned payload is ",distance,energy" and is parsed numerically.
    SerialInRecord(ComC1, LastSerialRecord, 76, 0, 3338, SerialBytesReturned, 10)

    If SerialBytesReturned > 0 Then
      'LastSerialRecord holds ",distance,energy" (BeginWord 'L' is stripped)
      'So index 1 = empty, index 2 = distance, index 3 = energy
      SplitStr(ParsedNumeric, LastSerialRecord, ",", 3, 0)

      SerialParsedOK = False
      If ParsedNumeric(2) = ParsedNumeric(2) And ParsedNumeric(3) = ParsedNumeric(3) Then
        LastLightningDistanceKm = ParsedNumeric(2)
        LastLightningEnergy = ParsedNumeric(3)
        LightningRecordCount = LightningRecordCount + 1
        SerialParsedOK = True
        CallTable LightningEvents
      EndIf

      If Not SerialParsedOK Then
        ParseErrorCount = ParseErrorCount + 1
      EndIf
    EndIf

    'Event driven only. A row is written when the sensor actually reported
    'something, either as a parsed serial record or as a mirrored IRQ pulse.
    'Nothing is written on a quiet scan, so the table length is a count of
    'lightning activity rather than a count of minutes the logger was powered.
    If PulseSeenThisScan And Not SerialParsedOK Then
      CallTable LightningEvents
    EndIf
    PulseSeenThisScan = False
  NextScan
EndProg
