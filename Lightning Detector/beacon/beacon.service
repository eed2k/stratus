[Unit]
Description=Stratus Lightning Beacon Controller (relay/pilot lights)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=gwld1
WorkingDirectory=/home/gwld1/beacon
ExecStart=/usr/bin/python3 /home/gwld1/beacon/beacon_poller.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
