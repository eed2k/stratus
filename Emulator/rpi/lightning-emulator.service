# =========================================================================
#
#  Stratus AS3935 Lightning Emulator
#  systemd unit: runs the emulator headless off the Click's own buttons.
#
#  Property of METRON (PTY) LTD | Inteltronics
#  Developed by L.J. Esterhuizen, Inteltronics
#
# =========================================================================

[Unit]
Description=AS3935 lightning emulator (Thunder EMU Click, button fired)
Documentation=file:/opt/lightning-emulator/lightning_emulator.py
# The emulator is a bench instrument with no network by design, so there is
# deliberately no After=network-online.target here. Waiting on a network that
# will never come up would just delay start by the DHCP timeout.
After=local-fs.target
ConditionPathExistsGlob=/dev/i2c-*

[Service]
Type=simple

# Not root. CAP_SYS_NICE is the only privilege the emulator actually wants: it
# takes SCHED_FIFO for the length of a burst so a scheduler preemption cannot
# stretch the 300 us sample period and distort the waveform the AS3935 sees.
# Everything else it needs comes from group membership on the two device nodes.
#
# Deliberately NO SupplementaryGroups= here. It would be redundant, because
# systemd already applies the groups the user holds in the system group database
# and SupplementaryGroups only extends that list, and install.sh puts emulator1
# in i2c and gpio. Worse, naming a group that cannot be resolved is a hard
# failure: the unit dies with status=216/GROUP before the script ever runs. On a
# bench box with no console that presents as "the buttons do nothing", which is
# the most expensive symptom to chase. install.sh guards its usermod calls with
# getent, so a missing group degrades instead of breaking.
User=emulator1
AmbientCapabilities=CAP_SYS_NICE

# MUST be writable by emulator1. The lgpio C library creates its notification
# FIFOs (.lgd-nfy*) in the PROCESS WORKING DIRECTORY, not in /tmp. Pointing this
# at /opt/lightning-emulator, which install.sh owns as root, made lgpio fail with
#   xCreatePipe: Can't set permissions (436) for .../.lgd-nfy0
# gpiozero then fell through lgpio, rpigpio and pigpio to NativeFactory, which
# cannot service the button reads, so all three pins failed with EINVAL, the
# script concluded nothing could fire a strike and exited 1. The symptom was
# "the Click buttons do nothing", and it was a directory permission the whole
# time. RuntimeDirectory gives us /run/lightning-emulator owned by the service
# user, created before ExecStart and cleaned up on stop.
RuntimeDirectory=lightning-emulator
WorkingDirectory=/run/lightning-emulator
Environment=LG_WD=/run/lightning-emulator

# Flags live in /etc/default/lightning-emulator so they can be changed without
# editing a unit file. The leading "-" makes the file optional. Unbraced $EMU_ARGS
# is word split by systemd, which is what we want for a list of flags.
EnvironmentFile=-/etc/default/lightning-emulator
ExecStart=/usr/bin/python3 /opt/lightning-emulator/lightning_emulator.py --headless $EMU_ARGS

# Unbuffered, otherwise the status lines and every "[emu] fired" sit in Python's
# stdout buffer and the journal stays empty until the process exits.
Environment=PYTHONUNBUFFERED=1

# If the Click is not seated the script exits 1 with a clear message. Retry a few
# times in case this raced the I2C device appearing, then stop and stay failed so
# `systemctl status` shows the reason instead of hiding it in a restart loop.
Restart=on-failure
RestartSec=15

# SIGINT rather than SIGTERM: the script's KeyboardInterrupt handler is what
# parks the DAC, and leaving the coil driven while idle is the one state worth
# avoiding on shutdown.
KillSignal=SIGINT
TimeoutStopSec=20

# Modest hardening only, and deliberately not ProtectSystem=strict. The script
# writes nothing there, so strict would buy very little, and a sandbox rule
# quietly blocking lgpio presents as "the buttons do nothing", which is the single
# most expensive symptom to chase on a box with no console.
#
# Note on PrivateTmp: it is kept because it is harmless, NOT because lgpio needs
# it. lgpio writes to the working directory, which is why RuntimeDirectory above
# is the thing that actually matters.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
