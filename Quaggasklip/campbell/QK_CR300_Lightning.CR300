'=============================================================================
'  Stratus AS3935 Lightning Detection System
'  C2 continuity test, logger used as the meter
'
'  Property of METRON (PTY) LTD [Inteltronics]
'  Developer: L.J. Esterhuizen
'=============================================================================
' Site: QUAGGASKLIP
'
' Does NOT call SerialOpen, deliberately: C2 must stay a plain digital input for
' PortGet to read its level. Opening it as a serial port hands the terminal to
' the comms driver instead.
'=============================================================================

Const SCAN_MS = 100

Public C2Level As Long
Public C2Changes As Long
Public C2HighSamples As Long
Public C2LowSamples As Long

Dim PrevLevel As Long

BeginProg
  PrevLevel = -1

  Scan (SCAN_MS, mSec, 0, 0)

    PortGet (C2Level, C2)

    If C2Level = 1 Then
      C2HighSamples = C2HighSamples + 1
    Else
      C2LowSamples = C2LowSamples + 1
    EndIf

    If C2Level <> PrevLevel Then
      If PrevLevel <> -1 Then C2Changes = C2Changes + 1
      PrevLevel = C2Level
    EndIf

  NextScan
EndProg

