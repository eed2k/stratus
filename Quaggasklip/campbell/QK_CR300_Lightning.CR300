'=============================================================================
'
'  Stratus AS3935 Lightning Detection System
'  Logging the lightning records sent by the Raspberry Pi LDS
'
'  Property of METRON (PTY) LTD [Inteltronics]
'  Developer: L.J. Esterhuizen
'
'=============================================================================
' Site: QUAGGASKLIP
'
' Requires CR300 OS 6.0 or later. ComC2_Rx needs it. This unit is on 7.04.
'
' Record format, 9600 baud 8N1, 3.3 V TTL, CR LF terminated:
'
'   L,<distance_km>,<energy>
'
' distance_km is -1 when the sensor could not range the strike.
'
' Lightning is the only thing stored. The detector also sends H,<cpu>,<rssi> once
' a day, which this program recognises and drops: health belongs to the admin
' panel, which is the system of record for whether a unit is alive. So this
' logger cannot tell a quiet sky from a dead detector. The panel answers that.
'
' WIRING. Two signals and a ground, straight off the Pi's 40-pin header. The
' Click Shield mikroBUS sockets are not in this path.
'
'   Pi BCM 26   header pin 37   ->  CR300  C2      lightning records in
'   Pi BCM 19   header pin 35   ->  CR300  P_SW    strike pulse
'   Pi GND      header pin 39   ->  CR300  G       required
'
' BCM 26 is not a hardware UART pin, deliberately. The detector builds the 9600
' baud waveform in software with pigpio, so any free GPIO serves, and BCM 26 stays
' reachable with the shield fitted. Do not move this wire to BCM 14 expecting the
' hardware UART, because nothing transmits there. The unit confirms the pin at
' startup: "Campbell UART TX enabled on GPIO 26 @ 9600 baud".
'
' C2 is the terminal this program opens for receive. Nothing listens on C1.
'
' Ground is not optional. Without it the receiver samples noise and the only
' symptom is ParseErrorCount climbing.
'
' Cable screen: land it at the CR300 end only, on signal ground. Cut it back and
' insulate it at the Pi end. The shield has no earth of its own, so grounding
' both ends would turn the screen into a ground loop conductor.
'
' Pi side, already enabled, in /home/quaggasklip/lightning_config.json:
'   campbell_uart_enabled true, campbell_uart_tx_pin 26
'   pulse_mirror_enabled true, pulse_mirror_pin 19
' After editing: sudo systemctl restart lightning-detector
'
' The pulse mirror is an independent strike count taken straight off the sensor
' interrupt, so it does not depend on the serial line. PulseCountTotal and
' StrikeCount should track each other. Pulses ahead of serial means the serial
' path is dropping records; serial ahead of pulses means the pulse wire is at fault.
'=============================================================================

Const SCAN_MS = 200

Public LastDistanceKm As Float
Public LastEnergy As Long
Public StrikeCount As Long
Public StrikesToday As Long
Public ClosestTodayKm As Float
Public MaxEnergyToday As Long
Public PulseCountScan As Float
Public PulseCountTotal As Float
Public CountMismatch As Float

Public LastRecord As String * 48
Public BytesReturned As Float
Public Parsed(2) As Float
Public ParseErrorCount As Long

' Live only, never sampled into a table, so no health reaches storage. It is a
' positive witness that the wire and ground are good after weeks with no
' lightning, which ParseErrorCount alone cannot tell you.
Public HealthRecordCount As Long

Dim EventRowWritten As Boolean

'=============================================================================
' DATA TABLES
'
' Distance, energy and the independent pulse count. Nothing else is stored.
' PulseCountTotal is IEEE4 because it is cumulative and FP2 stops at 7999,
' where it would saturate and also become indistinguishable from NAN.
'=============================================================================

DataTable (LightningEvents, True, -1)
  Sample (1, LastDistanceKm, FP2)
  Sample (1, LastEnergy, Long)
  Sample (1, PulseCountTotal, IEEE4)
EndTable

DataTable (LightningDaily, True, -1)
  DataInterval (0, 1, Day, 10)
  Sample (1, StrikesToday, Long)
  Sample (1, ClosestTodayKm, FP2)
  Sample (1, MaxEnergyToday, Long)
  Totalize (1, PulseCountScan, IEEE4, False)
EndTable

'=============================================================================
' PROGRAM
'=============================================================================

BeginProg
  ClosestTodayKm = NAN
  MaxEnergyToday = 0
  StrikesToday = 0

  SerialOpen (ComC2_Rx, 9600, 0, 0, 256)
  SerialFlush (ComC2_Rx)

  Scan (SCAN_MS, mSec, 0, 0)

    EventRowWritten = False

    ' PConfig 2 = switch closure, POption 0 = counts.
    PulseCount (PulseCountScan, 1, P_SW, 2, 0, 1, 0)
    PulseCountTotal = PulseCountTotal + PulseCountScan

    ' BeginWord 0 keeps the whole line. EndWord 3338 is &H0D0A, CR LF.
    ' Option 10 takes the oldest buffered record, so a burst drains in order.
    SerialInRecord (ComC2_Rx, LastRecord, 0, 0, 3338, BytesReturned, 10)

    If BytesReturned > 0 Then

      ' Only L is logged, H is dropped, anything else is a parse error.
      ' Two characters, not one: testing only for "L" would also accept a
      ' corrupted line like "LL,1,2" and log its numbers as a real strike.
      If Left (LastRecord, 2) = "L," Then

        ' SplitOption 0 is NUMERIC: it keeps + - . 0-9 E and discards everything
        ' else as a delimiter. So "L,12,45" gives exactly two values, in
        ' Parsed(1) and Parsed(2). The leading letter does not take a slot.
        SplitStr (Parsed(1), LastRecord, ",", 2, 0)

        ' x = x is false only for NAN, which catches a failed parse.
        If Parsed(1) = Parsed(1) AND Parsed(2) = Parsed(2) Then
          LastDistanceKm = Parsed(1)
          LastEnergy = Parsed(2)
          StrikeCount = StrikeCount + 1
          StrikesToday = StrikesToday + 1

          If LastEnergy > MaxEnergyToday Then MaxEnergyToday = LastEnergy

          ' -1 means unrangeable, so it is not a closest-of-day candidate.
          If LastDistanceKm >= 0 Then
            If ClosestTodayKm <> ClosestTodayKm Then
              ClosestTodayKm = LastDistanceKm
            ElseIf LastDistanceKm < ClosestTodayKm Then
              ClosestTodayKm = LastDistanceKm
            EndIf
          EndIf

          EventRowWritten = True
          CallTable LightningEvents
        Else
          ParseErrorCount = ParseErrorCount + 1
        EndIf

      ElseIf Left (LastRecord, 2) = "H," Then

        ' H,<cpu_temp_c>,<rssi_dbm>. Counted live, then dropped. Deliberately
        ' NOT added to ParseErrorCount: routine traffic accumulating in the
        ' fault counter would hide a missing ground or a baud mismatch.
        HealthRecordCount = HealthRecordCount + 1

      Else
        ParseErrorCount = ParseErrorCount + 1
      EndIf
    EndIf

    CountMismatch = PulseCountTotal - StrikeCount

    ' A pulse with no serial record still deserves a row: the pulse is the
    ' hardware witness that the sensor fired. Gated on EventRowWritten so it
    ' cannot double up with the strike row above.
    If PulseCountScan > 0 And Not EventRowWritten Then
      CallTable LightningEvents
    EndIf

    ' Called every scan on purpose: Totalize accumulates once per CallTable, so
    ' gating this on IfTime would build the daily total from one sample a day.
    ' DataInterval decides when the row is written.
    CallTable LightningDaily

    ' Reset today's figures after the daily row is written above.
    If IfTime (0, 1, Day) Then
      StrikesToday = 0
      ClosestTodayKm = NAN
      MaxEnergyToday = 0
    EndIf

  NextScan
EndProg
