'=============================================================================
'
'  Stratus AS3935 Lightning Detection System
'  C2 serial receive diagnostic
'
'  Property of METRON (PTY) LTD [Inteltronics]
'  Developer: L.J. Esterhuizen
'
'=============================================================================
' Site: QUAGGASKLIP
'
' TEMPORARY DIAGNOSTIC. Load this, run the send from the Pi, read the Public
' table, then load QK_CR300_Lightning.CR300 again. This program stores nothing.
'
' Why it exists: the production program reported BytesReturned 0. That is what
' you see when no signal arrives AND when a signal arrives but cannot be framed
' into a CR LF terminated record. Those two faults need opposite fixes, so this
' reports the raw state of the port rather than the parsed result.
'
' It deliberately does not call SerialInRecord. SerialInBlock consumes the same
' buffer, so running both would have them competing for the same bytes.
'
' READ THE ANSWERS IN THIS ORDER
'
'   BytesWaiting = -1
'       The port is not open. SerialInChk returns -1 for an unopened port, so
'       this is conclusive and nothing below matters. Check SerialOpenOK.
'
'   SerialOpenOK = FALSE
'       SerialOpen refused. C2 is likely claimed by something else. The
'       production program discards this return value, which is why a failed
'       open there looks exactly like a dead wire.
'
'   TotalBytesSeen = 0, SerialOpenOK = TRUE
'       The port is open and listening, and not one byte has arrived. The fault
'       is electrical: signal wire, ground return, or the terminal itself.
'
'   TotalBytesSeen > 0
'       The wire is good and the bytes are getting in. Now look at RawIn.
'
'   RawIn shows readable text such as L,40,1234567
'       Levels, baud and polarity are all correct, and the fault is in framing
'       or parsing, not the link.
'
'   RawIn shows unreadable characters
'       Bytes arrive but are being misread, which means the baud rate is wrong
'       or the signal is inverted relative to what the port expects.
'
' WIRING UNDER TEST
'   Pi BCM 14  ->  CR300 C2      records in
'   Pi GND     ->  CR300 G       required
'=============================================================================

Const SCAN_MS = 200

' SerialOpen returns True on success. The production program throws this away.
Public SerialOpenOK As Boolean

' SerialInChk counts bytes in the buffer before anything consumes them, and
' returns -1 if the port was never opened. This is the measurement that tells a
' dead wire apart from a framing fault, because it counts bytes whether or not
' they form a valid record.
Public BytesWaiting As Long
Public MaxBytesWaiting As Long

Public BytesThisScan As Long
Public TotalBytesSeen As Long
Public RawIn As String * 64

'=============================================================================
' PROGRAM
'=============================================================================

BeginProg

  SerialOpenOK = SerialOpen (ComC2_Rx, 9600, 0, 0, 256)
  SerialFlush (ComC2_Rx)

  Scan (SCAN_MS, mSec, 0, 0)

    BytesWaiting = SerialInChk (ComC2_Rx)
    If BytesWaiting > MaxBytesWaiting Then MaxBytesWaiting = BytesWaiting

    If BytesWaiting > 0 Then
      ' Raw, with no terminator and no parsing, so nothing can be discarded on
      ' the way in.
      BytesThisScan = SerialInBlock (ComC2_Rx, RawIn, 48)
      TotalBytesSeen = TotalBytesSeen + BytesThisScan
    EndIf

  NextScan
EndProg
