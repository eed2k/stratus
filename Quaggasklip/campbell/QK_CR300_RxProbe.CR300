'=============================================================================
'
'  Stratus AS3935 Lightning Detection System
'  CR300 receive probe. Diagnostic only, NOT the production program.
'
'  Property of METRON (PTY) LTD [Inteltronics]
'  Developer: L.J. Esterhuizen
'
'=============================================================================
' Site: QUAGGASKLIP.
'
' WHAT THIS IS FOR
'
' The link delivers the right NUMBER of bytes and the wrong VALUES. A five record
' burst of 14 byte records gave BytesSeenTotal 70 for 70 bytes sent, and the
' records were spaced 1.5 s apart against a 200 ms scan, so each sat alone in the
' buffer and was counted as exactly 14. That count is genuine reception, not noise.
' The latched string then came back as high-bit rubbish where plain ASCII was sent.
'
' Right bit count with wrong bit values is a receiver whose timing or framing does
' not match the transmitter. The Pi side is ruled out: its waveform was captured at
' the pad and self-decodes byte for byte with a 46% sampling margin.
'
' THE MEASUREMENT
'
' RxCode(1..16) holds the received byte values as plain numbers. For the test
' record "L,40,1234567" plus CR LF a healthy link reads:
'
'   76 44 52 48 44 49 50 51 52 53 54 55 13 10
'
' Read it like this:
'   exactly those numbers   the link is good
'   values above 127        corruption. Compare RxCode against the expected list
'                           to work out the ratio, then drop BaudSet
'   everything shifted      baud mismatch rather than noise
'   RawLen stays 0          nothing is arriving at this format and baud at all
'
' WHY FORMAT 3 IS THE DEFAULT
'
' FmtSel starts at 3, not 0. Format 0 is 8N1 but it leaves PakBus running
' concurrently on this same port and filters nulls and every character above 127
' while it searches for PakBus frames. That makes it both a prime suspect for the
' corruption and a destroyer of the evidence, since the corrupt bytes we most need
' to see are exactly the ones it discards. Format 3 is binary 8N1, no PakBus, no
' filtering. Campbell's own note says to use 3 in place of 0 for anything that is
' not guaranteed plain ASCII.
'
' Set FmtSel to 0 to compare. Both are literals in the two branches below, because
' SerialOpen takes the format as a constant.
'
' WHY SerialInBlock AND NOT SerialIn
'
' SerialInBlock returns the number of bytes received and needs no terminator.
' SerialIn waits for an LF, so if the arriving bytes are corrupt there may be no
' LF among them and the read returns nothing, which is indistinguishable from a
' dead line. It also stops at the first null, and a null is exactly the kind of
' byte corruption produces. SerialInBlock has neither problem, so the byte count
' here is the true one.
'
' BAUD IS LIVE
'
' SerialOpen accepts a variable for BaudRate, so BaudSet can be changed straight
' from the Public table and the port reopens itself. No recompile, no upload.
' Legal: 300 1200 2400 4800 9600 19200 38400 57600 115200. The port is closed
' before the change, which Campbell require.
'
' HOW TO USE IT
'
' 1. Upload. It opens at 9600, format 3.
' 2. Ask for one record to be sent:  qk_send_at_baud.sh 9600 1
' 3. Read RawLen, RxCodeLen and RxCode(1) to RxCode(16).
' 4. To retry, set ReArm true. To change speed, set BaudSet and send at the same
'    speed. To compare formats, set FmtSel 0 or 3.
'
' Wiring unchanged: Pi BCM 26 to C2 on the Terminal 2 Click "INT" terminal,
' BCM 19 to P_SW on "RST", grounds common. 9600 8N1, records CR LF terminated.
'=============================================================================

Const SCAN_MS = 200
Const CR_CODE = 13
Const CODES = 16             ' leading bytes published
Const GRAB = 32              ' bytes per SerialInBlock call

' Set these from the Public table.
Public BaudSet As Long
Public FmtSel As Long
Public ReArm As Boolean

' THE MEASUREMENT.
Public RawLen As Long
Public RxCode(CODES) As Long
Public RxCodeLen As Long
Public FirstRecord As String * 64

' Link state.
Public SerialOpenOK As Boolean
Public BytesSeenTotal As Long
Public ReadsWithBytes As Long
Public PulseCountTotal As Float

' Parse attempt, so a good record still proves itself end to end.
Public LastDistanceKm As Float
Public LastEnergy As Long
Public StrikeCount As Long
Public LPos As Long

Dim RawBuf As String * 64
Dim BaudNow As Long
Dim FmtNow As Long
Dim Parsed(2) As Float
Dim Payload As String * 64
Dim PulseScan As Float
Dim I As Long

DataTable (LightningEvents, True, -1)
  Sample (1, LastDistanceKm, FP2)
  Sample (1, LastEnergy, Long)
EndTable

BeginProg

  BaudSet = 9600
  FmtSel = 3
  BaudNow = BaudSet
  FmtNow = FmtSel

  ' Opened with a literal 3 to match FmtNow, so the reopen below does not fire on
  ' the first scan.
  SerialOpenOK = SerialOpen (ComC2_Rx, BaudNow, 3, 0, 256)
  SerialFlush (ComC2_Rx)

  Scan (SCAN_MS, mSec, 0, 0)

    ' Reopen when either setting is changed from the Public table.
    If BaudSet <> BaudNow OR FmtSel <> FmtNow Then
      SerialClose (ComC2_Rx)
      BaudNow = BaudSet
      FmtNow = FmtSel
      If FmtNow = 0 Then
        SerialOpenOK = SerialOpen (ComC2_Rx, BaudNow, 0, 0, 256)
      Else
        SerialOpenOK = SerialOpen (ComC2_Rx, BaudNow, 3, 0, 256)
      EndIf
      SerialFlush (ComC2_Rx)
      RxCodeLen = 0
      RawLen = 0
      FirstRecord = ""
    EndIf

    If ReArm Then
      RxCodeLen = 0
      RawLen = 0
      FirstRecord = ""
      For I = 1 To CODES
        RxCode(I) = 0
      Next I
      SerialFlush (ComC2_Rx)
      ReArm = False
    EndIf

    ' Live cross-check, independent of the serial line.
    PulseCount (PulseScan, 1, P_SW, 2, 0, 1, 0)
    PulseCountTotal = PulseCountTotal + PulseScan

    ' No terminator, no null sensitivity, and the return value is the true count.
    RawLen = SerialInBlock (ComC2_Rx, RawBuf, GRAB)

    If RawLen > 0 Then

      ReadsWithBytes = ReadsWithBytes + 1
      BytesSeenTotal = BytesSeenTotal + RawLen

      ' Capture once, so the first arrival is preserved rather than overwritten.
      If RxCodeLen = 0 Then
        FirstRecord = RawBuf
        RxCodeLen = RawLen
        If RxCodeLen > CODES Then RxCodeLen = CODES
        For I = 1 To RxCodeLen
          RxCode(I) = ASCII (RawBuf(1,1,I))
        Next I
      EndIf

      ' Best effort parse. If the bytes are clean this stores a row and settles it.
      LPos = InStr (1, RawBuf, "L,", 2)
      If LPos > 0 Then
        Payload = Mid (RawBuf, LPos + 2, GRAB)
        SplitStr (Parsed(1), Payload, "", 2, 0)
        If Parsed(1) = Parsed(1) AND Parsed(2) = Parsed(2) Then
          LastDistanceKm = Parsed(1)
          LastEnergy = Parsed(2)
          StrikeCount = StrikeCount + 1
          CallTable LightningEvents
        EndIf
      EndIf
    EndIf

  NextScan
EndProg
