# ─────────────────────────────────────────────
# Stratus .gitignore
# ─────────────────────────────────────────────

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python virtual environments, including the throwaway one used to run the
# LDS admin panel test suite locally.
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/

# ── Web build outputs ──
dist/
build/
tmp_dist/
.next/
out/
output/

# Compiled shared files (generated from .ts sources)
shared/*.js
shared/*.d.ts

# ── Environment / secrets ──
.env
.env.local
.env.*.local
.env.production.local
deploy/.env.production
.neon
.mailmap

# ── IDE / editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.#*

# ── OS files ──
.DS_Store
Thumbs.db

# ── Logs ──
logs/
*.log

# ── Temp / cache ──
temp/
tmp/
.cache/

# ── Database files ──
*.db
*.sqlite

# ── Docker ──
docker-compose.override.yml

# ── Data files (samples live in demo_data/ only) ──
*.dat
*.backup
*.tdf
*.xlsx
*.emf
# Un-ignoring the directory alone is not enough: *.dat above still matches the
# files inside it, so the demo samples need an explicit negation of their own.
!demo_data/
!demo_data/*.dat

# ── CRBasic programs (keep in examples/crbasic/ only) ──
*.CR300
*.CRB
*.cr300

# ── Archives / build bundles ──
*.tar.gz
*.tar
*.zip

# ── Images (tracked assets live in assets/) ──
*.png

# ── Build logs ──
build.log

# ── Sensitive / ad-hoc root-level scripts ──
access_token.txt
test_neon.js
check_timestamps.js
del_stations.js
set_server.js
fix_encoding.js
check_mppt_tmp.js
check_mppt_api.py
mppt_test.sql
update_coords.sql
scripts/login.json

# ── Deploy state and output files ──
deploy/deploy_output.txt
deploy/vps_state.txt
deploy/check_vps.py
deploy/check_vps_setup.py
deploy/monitor_build.py
deploy/poll_build.py
deploy/quick_check.py
deploy/rebuild_vps.py
deploy/restart_container.py
deploy/deploy_lean.py

# ── Desktop (removed; ignore entire folder if re-created) ──
desktop/
*.user
*.suo

# ── Release binaries (too large for GitHub) ──
release/
*.exe
*.blockmap
*.nupkg
windrose-main/

# ── Ephemeral deploy helpers + scratch dirs (not for repo) ──
deploy/_*.sh
deploy/_remote.py
deploy/_sftp.py
sun-animation12345/
calibration-rainfall-update/
LDS ADMIN PANEL/
