# ─────────────────────────────────────────────
# Stratus .gitignore
# ─────────────────────────────────────────────

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python virtual environments, including the throwaway one used to run the
# LDS admin panel test suite locally.
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/

# ── Web build outputs ──
dist/
build/
tmp_dist/
.next/
out/
output/

# Compiled shared files (generated from .ts sources)
shared/*.js
shared/*.d.ts

# ── Environment / secrets ──
.env
.env.local
.env.*.local
.env.production.local
deploy/.env.production
.neon
.mailmap

# ── IDE / editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.#*

# ── OS files ──
.DS_Store
Thumbs.db

# ── Logs ──
logs/
*.log

# ── Temp / cache ──
temp/
tmp/
.cache/

# ── Database files ──
*.db
*.sqlite

# ── Docker ──
docker-compose.override.yml

# ── Data files (samples live in demo/ only) ──
*.dat
*.backup
*.tdf
*.xlsx
*.emf
# Un-ignoring the directory alone is not enough: *.dat above still matches the
# files inside it, so the demo samples need an explicit negation of their own.
!demo/
!demo/*.dat

# ── CRBasic programs (keep in examples/crbasic/ only) ──
*.CR300
*.CRB
*.cr300

# ── Archives / build bundles ──
*.tar.gz
*.tar
*.zip

# ── Images (tracked assets live in assets/) ──
*.png

# ── Video / large media (not source; keep repo lean) ──
*.m4v
*.mp4
*.mov

# ── Build logs ──
build.log

# ── Sensitive / ad-hoc root-level scripts ──
access_token.txt
test_neon.js
check_timestamps.js
del_stations.js
set_server.js
fix_encoding.js
check_mppt_tmp.js
check_mppt_api.py
mppt_test.sql
update_coords.sql
scripts/login.json

# ── Downloaded VPS backups ──
# These contain live .env files (database URLs, API keys, webhook tokens) and
# database dumps. They must never be committed.
backups/
deploy/_recon.py
deploy/_pre_upgrade_backup.py

# ── Deploy state and output files ──
deploy/deploy_output.txt
deploy/vps_state.txt
deploy/check_vps.py
deploy/check_vps_setup.py
deploy/monitor_build.py
deploy/poll_build.py
deploy/quick_check.py
deploy/rebuild_vps.py
deploy/restart_container.py
deploy/deploy_lean.py

# ── Desktop (removed; ignore entire folder if re-created) ──
desktop/
*.user
*.suo

# ── Release binaries (too large for GitHub) ──
release/
*.exe
*.blockmap
*.nupkg
windrose-main/

# ── Ephemeral deploy helpers + scratch dirs (not for repo) ──
deploy/_*.sh
deploy/_remote.py
deploy/_sftp.py
sun-animation12345/
calibration-rainfall-update/
LDS ADMIN PANEL/

# ── Environment files beyond the plain `.env` rule above ──
# `.env` alone does not match `.env.vps`, `.env.staging` and friends, and one of
# those held a live Clickatell API key. Ignore every variant, then re-admit the
# documentation templates explicitly.
.env.*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# ── Raspberry Pi SD card: real credentials ──
# These three cloud-init files carry a wifi PSK and a user password hash. Both
# are directly usable, and git history keeps them recoverable forever, so only
# the sanitized *.example templates are tracked.
RPiZero SD Card/user-data
RPiZero SD Card/network-config
RPiZero SD Card/meta-data

# ── Raspberry Pi SD card: stock Raspberry Pi OS boot firmware ──
# Around 83 MB of Raspberry Pi Foundation binaries that we do not author and
# cannot usefully diff. They come back verbatim with any Raspberry Pi OS image,
# so versioning them only bloats the repo permanently.
# Tracked from this folder: config.txt, cmdline.txt, FLASH_FROM_SCRATCH.md,
# gwld1-deploy/ and the *.example templates, which are the parts we actually own.
RPiZero SD Card/*.dtb
RPiZero SD Card/*.elf
RPiZero SD Card/*.img
RPiZero SD Card/initramfs*
RPiZero SD Card/bootcode.bin
RPiZero SD Card/fixup*.dat
RPiZero SD Card/LICENCE.broadcom
RPiZero SD Card/issue.txt
RPiZero SD Card/overlays/

# ── Editor scratch backups ──
# Left behind by in-place edits; never meant to be committed.
*.bak.cursor
*.bak.[0-9]*
config.txt.bak.*
cmdline.txt.bak.*

# ── Editor / tool local history (auto-generated, not source) ──
.history/
.history
.history_trim
