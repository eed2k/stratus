	(text "LORA & SIGFOX MODULE [LSM1OOA 868MHZ]"
		(exclude_from_sim no)
		(at 67.818 176.276 0)
		(effects
			(font
				(size 3 3)
				(thickness 0.4)
				(bold yes)
			)
		)
		(uuid "023f405d-9cb0-4e24-ae82-cf40a77d4d50")
	)
	(text "LSM100A talks to the MCU over its own dedicated hardware \nUART (LSM_UART_TX/RX on ATmega1284P pins 11/12) — separate from the UART used for the \nSDI-12 bridge — plus three MCU-driven control lines: LSM_WAKE, LSM_BOOT, and LSM_RESET \n(the latter pulled up via R10, with no physical reset button — reset is software-only from the MCU). \nIts RF output (pin 33) runs through an L1/C5/C16 matching network to the J10 IPEX antenna connector, \nwith a status LED (D1) tied off one of the modem's own indicator pins. It runs directly off the \nboard's 3.3V rail with multiple dedicated GND pins for RF grounding, consistent with the rest of the \ndesign's \"no USB, no separate battery\" philosophy — everything is powered from the single logger supply."
		(exclude_from_sim no)
		(at 17.018 260.096 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0b5cc9a6-6eab-473b-ad51-d4072e987b0e")
	)
	(text "SWD PROG FOR LSM100A"
		(exclude_from_sim no)
		(at 24.13 183.134 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "140df23d-4dbd-4921-be7b-38c6ae369f8f")
	)
