	(text "Not included in Rev1.0 of this design\nReference circuit for future iterations\nPowering the logger with a 6Vdc 3W solar panel\nand a 18650 3000mAh cell"
		(exclude_from_sim no)
		(at 439.42 52.07 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
				(color 255 255 255 1)
			)
			(justify left)
		)
		(uuid "4a646b1b-5d98-4d51-a0ab-b567a61225cc")
	)
	(text "SDI-12 requires the data line driven HIGH for ≥12 ms to wake sensors.\nWith the 12V supply continuous and always-on, no power-sequencing logic \nis needed, just the corrected break/mark timing and a one-time sensor \nwarm-up delay after the logger itself powers on."
		(exclude_from_sim no)
		(at 84.328 326.136 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "4d85ff31-4d49-4c0c-b565-8ec23d2939ad")
	)
