# Application
APP_SECRET_KEY=change-me-to-a-long-random-string

# DATABASE_URL
# Local dev (SQLite):
#   sqlite:///./data/panel.db
# Production (Neon Postgres) - copy the "Pooled connection" string from Neon
# console; the panel auto-rewrites postgres:// -> postgresql+psycopg:// and
# appends sslmode=require if missing.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb

ALERT_WEBHOOK_TOKEN=change-me-shared-with-pi

# Keep true in production (HTTPS). Set false only for local HTTP testing.
SECURE_COOKIES=true

# SMS gateway (SMS only; no WhatsApp).
#
# The send endpoint is configurable so the gateway can be changed without a code
# change. Leave the default unless you are moving supplier.
SMS_GATEWAY_URL=https://platform.clickatell.com/v1/message
SMS_GATEWAY_API_KEY=
# Optional: shared secret expected on inbound delivery-receipt callbacks.
# Configure the same value in the gateway's delivery-notification settings, and
# point them at https://<your-panel-host>/api/sms/dlr
SMS_GATEWAY_DLR_TOKEN=
#
# Older deployments used CLICKATELL_API_KEY and CLICKATELL_DLR_TOKEN. Those names
# are still read as a fallback, so an existing .env keeps working untouched; the
# SMS_GATEWAY_* names above take precedence when both are set.

# Site name in SMS alert text, e.g. GLENCORE WONDERKOP
SITE_NAME=GLENCORE WONDERKOP

# Initial admin login (full access). Seeded on first boot if missing.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe!123

# Initial operator login (site user). Seeded on first boot if missing.
INITIAL_OPERATOR_EMAIL=operator@example.com
INITIAL_OPERATOR_PASSWORD=ChangeMe!Op-123
