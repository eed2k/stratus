# Test image for the Lightning Alert admin panel.
#
# Deliberately a separate file rather than an extra stage in Dockerfile:
# docker-compose.yml builds with `build: .` and no `target:`, and Docker builds
# the last stage of a multi-stage file by default, so a test stage appended to
# the production Dockerfile would become what the live container runs.
#
# The point of running the suite in a container is WeasyPrint. It needs Pango
# and GObject through cffi, which are not present on a typical Windows or macOS
# developer machine, so tests/test_reports.py::test_pdf_bytes_when_weasyprint_available
# skips itself there. In here those libraries exist, so that check actually
# executes and asserts real %PDF bytes.
#
# Build and run:
#   docker build -f Dockerfile.test -t lds-admin:test .
#   docker run --rm lds-admin:test
#
# Base image and system libraries are kept in step with Dockerfile on purpose:
# testing against a different set of native libraries than production ships
# would defeat the object.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libffi8 \
        libgdk-pixbuf-2.0-0 libjpeg62-turbo shared-mime-info fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt ./
RUN pip install -r requirements-dev.txt

COPY app ./app
COPY tests ./tests
COPY pytest.ini ./

# A throwaway SQLite file under /tmp, never the mounted data volume, so a test
# run cannot touch production data even if this image is run on the VPS.
ENV DATABASE_URL="sqlite:////tmp/lds_admin_test.db" \
    SECURE_COOKIES=false \
    APP_SECRET_KEY="test-secret-key-that-is-long-enough-000000000000" \
    ALERT_WEBHOOK_TOKEN="test-token" \
    CLICKATELL_API_KEY="" \
    CLICKATELL_DLR_TOKEN=""

CMD ["python", "-m", "pytest", "-q", "-p", "no:warnings"]
