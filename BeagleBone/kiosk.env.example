# Stratus BeagleBone kiosk configuration.
# Copy this to /etc/stratus-kiosk.env and edit the URL, then:
#   sudo systemctl restart stratus-kiosk
#
# The page the kiosk shows full screen. For a wall display, use a shared
# dashboard link. The compact dashboard is built for exactly this: a single,
# non-scrolling screen that scales to fill any monitor or TV.
#
#   Compact wall board:  https://stratusweather.co.za/shared/<SHARE_TOKEN>/compact
#   Full shared board:   https://stratusweather.co.za/shared/<SHARE_TOKEN>
#
# Create the share link from the station's dashboard in Stratus (Share), then
# paste it here with /compact appended for the wall-board layout.
STRATUS_KIOSK_URL="https://stratusweather.co.za/shared/REPLACE_WITH_SHARE_TOKEN/compact"

# Seconds to wait for the network before launching the browser. The USB Wi-Fi
# or cellular link can take a few seconds to come up after boot.
STRATUS_KIOSK_NETWORK_WAIT=20

# Set to 1 to rotate the display 180 degrees (useful when the board is mounted
# upside down behind a screen). Leave blank or 0 for normal orientation.
STRATUS_KIOSK_ROTATE=0
