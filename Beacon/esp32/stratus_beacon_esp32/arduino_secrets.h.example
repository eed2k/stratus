// Copy this file to  arduino_secrets.h  and fill in the real values.
// arduino_secrets.h is gitignored and must never be committed.

// WiFi the beacon joins. Same network the detector is on.
#define WIFI_SSID       "4GUFI_4833"
#define WIFI_PASSWORD   "REPLACE_WITH_WIFI_PASSWORD"

// Ingest/beacon token for the Quaggasklip tenant. Must match the value the
// panel accepts for /quaggasklip/ (ALERT_WEBHOOK_TOKEN_QUAGGASKLIP on the
// server). Do NOT use the Glencore token here.
#define PANEL_AUTH_TOKEN "REPLACE_WITH_QUAGGASKLIP_TOKEN"
