# Beacon configuration. Copy to /etc/stratus-beacon.env and chmod 600.
#
#   sudo install -m 600 beacon.env.example /etc/stratus-beacon.env
#   sudo nano /etc/stratus-beacon.env
#
# The file holds an API token, so it must not be world readable and must not be
# committed. Beacon/.gitignore excludes the non-example form.

# ---- panel ----------------------------------------------------------------
BEACON_PANEL_URL=https://adminpanel.stratusweather.co.za

# Must match ALERT_WEBHOOK_TOKEN on the panel. If the panel has a token set and
# this is blank or wrong, every poll returns HTTP 401 and the beacon will sit on
# its fail state.
BEACON_TOKEN=

# Scope the reply to one detector's client. Leave blank only while a single
# client is live: without it the answer spans every unit on the panel, so
# another client's detector could hold your green lamp on.
BEACON_STATION_ID=GLENCORE WONDERKOP

# ---- timing ---------------------------------------------------------------
# Seconds between polls. 10 s is responsive without being rude to the panel;
# the VPS is a single small instance.
BEACON_POLL_SECONDS=10
BEACON_HTTP_TIMEOUT=10

# Orange burst on a new in-range strike: 1 s on, 1 s off, for 10 s total.
BEACON_FLICKER_PERIOD=1
BEACON_FLICKER_SECONDS=10

# ---- relay HAT (BCM pin numbers) -----------------------------------------
BEACON_PIN_GREEN=17
BEACON_PIN_RED=27
BEACON_PIN_ORANGE=22

# Most opto-isolated relay HATs energise the coil on a LOW output. If your lamps
# come on when they should be off, flip this to false rather than rewiring.
BEACON_RELAY_ACTIVE_LOW=true

# ---- failure behaviour ----------------------------------------------------
# What to show when the panel cannot be reached: red or dark.
#
# There is intentionally no "green" option. If the panel is unreachable we do not
# know whether the detector is alive, and a green lamp on a lightning warning
# system asserts a safety claim that nothing is backing. Red is the honest
# default; dark is available if you would rather show nothing than a maybe-wrong
# red.
BEACON_FAIL_STATE=red

# ---- diagnostics ---------------------------------------------------------
# Run the poller with no GPIO at all, for testing on a laptop.
BEACON_DRY_RUN=false
BEACON_DEBUG=false
